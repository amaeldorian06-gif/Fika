# ============================================================
#  FIKA — modèle de configuration. Copier en `.env` et remplir.
#  NE JAMAIS écrire de vraie valeur dans CE fichier (il est public).
# ============================================================

# --- Base de données (Supabase, chaînes "pooler" = compatibles IPv4/Vercel) ---
# Application (Transaction pooler, port 6543) :
DATABASE_URL="postgresql://postgres.<ref-projet>:<MOT_DE_PASSE_ENCODE>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations / prisma db push (Session pooler, port 5432) :
DIRECT_URL="postgresql://postgres.<ref-projet>:<MOT_DE_PASSE_ENCODE>@<region>.pooler.supabase.com:5432/postgres"
# Un mot de passe contenant @ # / : ? doit être encodé (ex. "@" -> "%40").

# --- Sécurité des sessions admin (optionnel) ---
# Si vide, le secret de session est dérivé automatiquement de DATABASE_URL :
# une seule variable suffit pour faire tourner Fika en production.
AUTH_SECRET=

# --- Compte administrateur ---
# Le fondateur se connecte avec les identifiants intégrés au code
# (server/lib/founder.ts : e-mail + hash bcrypt). Aucune variable requise.
# Pour changer son mot de passe sans modifier le code : hash bcrypt ici.
FOUNDER_PASSWORD_HASH=
# Les variables ci-dessous ne servent qu'à créer d'éventuels admins
# supplémentaires via `npm run admin:seed` (optionnel).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# --- Alerte e-mail à chaque nouvelle demande (optionnel, recommandé) ---
# Gmail : compte Google → Sécurité → Validation en deux étapes → Mots de passe
# des applications → créer « Fika » → coller les 16 caractères ci-dessous.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Destinataire des alertes (défaut : e-mail du fondateur)
NOTIFY_EMAIL=
# URL publique du site (lien « Traiter » dans l'e-mail), ex. https://fika.vercel.app
APP_URL=

# --- Numéro WhatsApp public (E.164), figé au build Vite ---
VITE_WA_PHONE="+237686382354"

# --- Optionnel ---
# PORT=3000
# TRUST_PROXY_HOPS=1
