# PostgreSQL / Prisma : copier dans .env (jamais versionner de secrets).
# Encoder les caractères spéciaux du mot de passe dans l'URL.
# Supabase : copier les URL exactes depuis Connect, ne pas inventer l'hôte.
# Runtime serverless : Transaction pooler (6543), options Prisma 5 ci-dessous.
DATABASE_URL="postgresql://USER.PROJECT:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Migrations : Session pooler (5432), ou connexion directe si IPv6 disponible.
DIRECT_URL="postgresql://USER.PROJECT:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
# PostgreSQL local sans pooler : DATABASE_URL et DIRECT_URL peuvent être identiques.

# Numéro WhatsApp public, source unique pour Vite.
VITE_WA_PHONE="+237671164936"
APP_URL="http://localhost:3000"
PORT=3000

# Compte fondateur : renseigner votre e-mail et un nouveau mot de passe.
ADMIN_EMAIL="amaeldorian06@gmail.com"
# Hash bcrypt recommandé, obligatoire en production.
ADMIN_PASSWORD_HASH=""
# Alternative locale uniquement (12 caractères minimum).
# ADMIN_PASSWORD=""

# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
# Nombre de proxys de confiance devant Express (0 par défaut).
# TRUST_PROXY_HOPS=1
